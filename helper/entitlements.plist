<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- carsurf-helperd is now a relay-only daemon: it reads the CarSurf
	     preferences and writes the app-readable relay at
	     /var/jb/Library/CarSurf/relay.plist. It no longer patches, re-signs,
	     trustcaches, or writes inside any app bundle, so the whole patching
	     privilege set that used to live here has been removed:
	       - storage.AppBundles / storage-exempt.heritable (write inside app
	         bundles; extend the exemption to spawned ldid/uicache),
	       - container-manager / MobileContainerManager.allowed /
	         storage.AppDataContainers / storage.containers (bundle containers),
	       - skip-library-validation / rootless.install.heritable (spawned tools),
	       - canmaplsdatabase / canmapbundleidtouuid /
	         lsapplicationworkspace.rebuildappdatabases (re-register a patched app).
	     What remains is only what a root relay writer needs: run as a platform
	     daemon outside a container, and read /var/mobile/Library/Preferences. -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.storage.preferences</key>
	<true/>
</dict>
</plist>
