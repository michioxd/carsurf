#!/bin/sh
# SpringBoard runs as mobile and mirrors the preferences into this directory for
# sandboxed app processes to read. /var/jb/Library is root-owned, so the directory
# has to be created here, at install time, and handed to mobile.
set -e

for ROOT in /var/jb /; do
    [ -d "$ROOT/Library" ] || continue
    DIR="$ROOT/Library/CarSurf"
    mkdir -p "$DIR"
    chown mobile:mobile "$DIR" 2>/dev/null || true
    chmod 755 "$DIR"
    break
done

# The shared log. Not every device has this directory — a 16.7.12 RootHide
# install did not — and without it SpringBoard and CarPlay.app quietly log into
# their own temporary directory instead, which is how the entire CarPlay half of
# the tweak came to leave no trace anywhere. Create it, and hand the log itself
# to mobile: carsurf-helperd runs as root and would otherwise create it 0644
# root-owned and lock those processes out.
LOGDIR=/var/mobile/Library/Logs
mkdir -p "$LOGDIR"
chown mobile:mobile "$LOGDIR" 2>/dev/null || true
[ -f "$LOGDIR/carsurf.log" ] && chmod 666 "$LOGDIR/carsurf.log" 2>/dev/null || true

# carsurf-helperd is now a minimal relay-only daemon: it publishes the
# app-readable preferences relay (/var/jb/Library/CarSurf/relay.plist) at boot and
# on every preference change, and does NOT patch, re-sign, trustcache, or touch any
# app bundle — CarPlay admission is done entirely at runtime. That makes it safe to
# run by default, and it is wanted: a fresh install that has not resprung yet, and
# RootHide (where SpringBoard's own CSRelay.m does not write), would otherwise have
# no relay at all and render a blank CarPlay screen.
#
# Earlier packages deliberately DISABLED this daemon because it used to do on-disk
# patching; that reason is gone, so load it and clear any persisted disabled state.
PLIST=/var/jb/Library/LaunchDaemons/com.pavunato.carsurf.helperd.plist
if [ -f "$PLIST" ] && [ -x /var/jb/usr/bin/launchctl ]; then
    # Unload the old binary first so an upgrade swaps in the new one, then load -w
    # to (re-)enable it, overriding the disabled state written by older packages.
    /var/jb/usr/bin/launchctl unload "$PLIST" 2>/dev/null || true
    /var/jb/usr/bin/launchctl load -w "$PLIST" 2>/dev/null || true
fi

exit 0
